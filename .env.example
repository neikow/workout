# Postgres
DATABASE_URL=postgres://workout:workout@localhost:5432/workout

# SMTP (defaults assume local MailHog on port 1025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Workout <no-reply@workout.local>"
SMTP_SECURE=false

# Cookie / session
SESSION_COOKIE_NAME=workout_session
# Set to true behind HTTPS in production
SESSION_COOKIE_SECURE=false
